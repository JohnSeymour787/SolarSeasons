    <string name="sun_info_solar_noon">太阳正午</string>
    <string name="sun_info_solar_noon_description">太阳正午时，太阳在日间天空中的位置最高，导致紫外线暴露最强。</string>
    <string name="sun_info_nadir">天底</string>
    <string name="sun_info_nadir_description">天底时，太阳位于地球下方的最低点，是夜晚最黑暗的时刻。</string>
    <string name="sun_info_sunrise">日出</string>
    <string name="sun_info_sunrise_description">日出标志着太阳的上边缘刚刚出现在地平线上的时刻。</string>
    <string name="sun_info_sunset">日落</string>
    <string name="sun_info_sunset_description">日落标志着太阳的下边缘开始没入地平线以下。此时，太阳的位置略低于日落开始时刻。</string>
    <string name="sun_info_sunrise_end">日出结束</string>
    <string name="sun_info_sunrise_end_description">一旦太阳的下边缘接触地平线，太阳正在上升时，日出正式结束。</string>
    <string name="sun_info_sunset_start">日落开始</string>
    <string name="sun_info_sunset_start_description">技术上，日落开始于太阳的下边缘接触地平线、太阳正在下降的那一刻。</string>
    <string name="sun_info_dawn">黎明</string>
    <string name="sun_info_dawn_description">黎明是从此时开始可以观察到间接日光的时段。</string>
    <string name="sun_info_dusk">黄昏</string>
    <string name="sun_info_dusk_description">黄昏是日落结束、夜晚即将来临的时段，此时只有间接日光仍可见。</string>
    <string name="sun_info_nautical_dawn">航海黎明</string>
    <string name="sun_info_nautical_dawn_description">航海黎明指的是水手对黎明的原始定义观测。天文黎明发生时太阳位于地平线下18度，而航海黎明定义为太阳位于地平线下12度。</string>
    <string name="sun_info_nautical_dusk">航海黄昏</string>
    <string name="sun_info_nautical_dusk_description">航海黄昏指的是水手对黄昏的原始定义观测。天文黄昏发生时太阳位于地平线下18度，而航海黄昏定义为太阳位于地平线下12度。</string>
    <string name="sun_info_night_end">夜晚结束</string>
    <string name="sun_info_night_end_description">这是夜晚正式结束的时间，就在黎明出现之前。</string>
    <string name="sun_info_night">夜晚</string>
    <string name="sun_info_night_description">这是夜晚正式开始、黄昏完全结束的时间。</string>
    <string name="sun_info_golden_hour_end">黄金小时结束</string>
    <string name="sun_info_golden_hour_end_description">这是早晨黄金小时结束的时间。黎明之后到此时是摄影的最佳时段。</string>
    <string name="sun_info_golden_hour">黄金小时开始</string>
    <string name="sun_info_golden_hour_description">这是傍晚黄金小时开始的时间。此时之后是摄影的最佳时段。</string>

